rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isShopOwner(shopId) {
      return isAuthenticated() && firestore.exists(/databases/(default)/documents/shops/$(shopId)) &&
        firestore.get(/databases/(default)/documents/shops/$(shopId)).data.ownerId == request.auth.uid;
    }

    function isShopMember(shopId) {
      return isAuthenticated() && firestore.exists(/databases/(default)/documents/shops/$(shopId)/members/$(request.auth.uid));
    }

    function hasValidAppCheck() {
      return request.app != null && request.app.verifyToken() != null;
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if isAuthenticated() && hasValidAppCheck();
      allow write: if isAuthenticated() && request.auth.uid == userId && hasValidAppCheck();
    }

    match /shops/{shopId}/{allPaths=**} {
      allow read: if isAuthenticated() && hasValidAppCheck();
      allow write: if isAuthenticated() && (isShopOwner(shopId) || isShopMember(shopId) || isAdmin())
        && hasValidAppCheck();
    }

    match /products/{productId}/{allPaths=**} {
      allow read: if isAuthenticated() && hasValidAppCheck();
      allow write: if isAuthenticated() && (
        firestore.exists(/databases/(default)/documents/products/$(productId)) && (
          firestore.get(/databases/(default)/documents/products/$(productId)).data.sellerId == request.auth.uid ||
          firestore.get(/databases/(default)/documents/products/$(productId)).data.shopId != null &&
          isShopOwner(firestore.get(/databases/(default)/documents/products/$(productId)).data.shopId)
        )
        || isAdmin()
      ) && hasValidAppCheck();
    }

    match /verifications/{userId}/{allPaths=**} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin())
        && hasValidAppCheck();
      allow write: if isAuthenticated() && request.auth.uid == userId && hasValidAppCheck();
    }

    match /chats/{chatId}/{allPaths=**} {
      allow read: if isAuthenticated() && hasValidAppCheck();
      allow write: if isAuthenticated() && hasValidAppCheck();
    }

    match /banners/{allPaths=**} {
      allow read: if isAuthenticated() && hasValidAppCheck();
      allow write: if isAdmin();
    }
  }
}